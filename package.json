{
  "name": "funktrainer",
  "productName": "BOS Funktrainer",
  "version": "1.1.1",
  "description": "Trainingssimulator für den BOS-Sprechfunk (THW) mit Sprachein- und -ausgabe und simuliertem Funkgerät",
  "main": "main.js",
  "private": true,
  "author": "Funktrainer",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "web": "node scripts/serve.js",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "fetch-model": "node scripts/fetch-model.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.funktrainer.bos",
    "productName": "BOS Funktrainer",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Der Funktrainer benötigt das Mikrofon, damit du wie am echten Funkgerät sprechen kannst."
      },
      "artifactName": "BOS-Funktrainer.${ext}",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BOS Funktrainer",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BOS-Funktrainer-Setup.${ext}"
    },
    "afterPack": "build/adhoc-sign.js",
    "dmg": {
      "title": "BOS Funktrainer",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 185
        },
        {
          "x": 410,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "portable": {
      "artifactName": "BOS-Funktrainer-Portable.${ext}"
    }
  }
}
